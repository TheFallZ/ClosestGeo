# Copy this file to .env and fill in your key.

# Google API key with the Geocoding API and Maps JavaScript API enabled
GOOGLE_API_KEY=

# Optional: a separate key for the map shown in the browser, so you can restrict it
# to your website's address in Google Cloud Console. Defaults to GOOGLE_API_KEY.
GOOGLE_MAPS_BROWSER_KEY=

# Optional: port for the server (defaults to 3000)
PORT=
